# Optional overrides for docker-compose.yml (every variable has a default).
# cp .env.example .env

POSTGRES_USER=pulso
POSTGRES_PASSWORD=pulso-dev-only

# Host ports (support-agents listens on 8000 inside its container, like matching)
POSTGRES_PORT=5432
REDIS_PORT=6379
ORDERS_API_PORT=3000
MATCHING_PORT=8000
SUPPORT_AGENTS_PORT=8080
SAGA_PORT=8090

# orders-api refuses to start with a JWT secret shorter than 32 characters
JWT_SECRET=dev-only-jwt-secret-not-for-production

# support-agents: "scripted" runs offline; "anthropic" needs a real key
PULSO_LLM_PROVIDER=scripted
ANTHROPIC_API_KEY=dummy-anthropic-key
